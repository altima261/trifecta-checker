{
  "name": "Trifecta Checker",
  "description": "AI Safety Gate + Verified Human. LETHAL = BLOCKED, WARNING = ASK, SAFE = ALLOW.",
  "version": "1.0.0",
  "agent": {
    "id": "trifecta-checker-01",
    "role": "AI Safety Gate",
    "capabilities": ["private-data-check", "untrusted-content-check", "external-communication-check"]

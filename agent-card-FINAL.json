  "gate": {
    "LETHAL_3_3": "BLOCKED",
    "WARNING_2_3": "ASK Human Approval",
    "SAFE": "ALLOW",
    "timeout": "DENY",
    "lethal_override": false
  },
  "links": {
    "demo": "https://trifecta-checker-v2-eta.vercel.app",
    "repo": "https://github.com/altima261/trifecta-checker",
    "video": "https://youtu.be/C0CBPw6hq3g"
  },
  "concordium": {
    "track": "Make your Agents Accountable with Concordium",
    "zk_proof": "prove verified human without revealing personal data",
    "registry": "Agent Registry - every agent traceable to a verified human",
    "accountability": "every decision logged"
  },
  "defensive_only": true
